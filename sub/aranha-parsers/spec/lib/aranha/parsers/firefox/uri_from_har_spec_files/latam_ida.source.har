ribute-refund-notIncluded\":\"Reembolso de passagem\",\"xp_sales_web_main_brandAttribute-refund-partialIncluded\":\"{{totalAmount}} de reembolso\",\"xp_sales_web_main_brandAttribute-latamPlusSeat-included\":\"Assento LATAM\",\"xp_sales_web_main_brandAttribute-cabinUpgradeCoupons-included\":\"Uso de cupom para Upgrade\",\"xp_sales_web_main_brandAttribute-cabinUpgradeCoupons-notIncluded\":\"Uso de cupom para Upgrade\",\"xp_sales_web_main_brandPriceDetails\":\"Mais detalhes\",\"xp_sales_web_main_brandPriceTaxes\":\"Mais taxas.\",\"xp_sales_web_main_brandPricePaxDescription\":\"{{taxes}} Por passageiro\",\"xp_sales_web_main_brandSelectionButtonText\":\"Escolher\",\"xp_sales_web_main_brandAttribute-personalItem-included_a11y_label\":\"Bolsa ou mochila pequena\",\"xp_sales_web_main_brandAttribute-carryOnBaggage-included_a11y_label\":\"Bagagem de mão {{kilograms}} kg\",\"xp_sales_web_main_brandAttribute-carryOnBaggage-notIncluded_a11y_label\":\"Sem bagagem de mão {{kilograms}} kg\",\"xp_sales_web_main_brandAttribute-checkedBaggage-included_a11y_label\":\"{{count}} bagagem despachada {{kilograms}} kg\",\"xp_sales_web_main_brandAttribute-checkedBaggage-included_a11y_label_plural\":\"{{count}} bagagens despachadas {{kilograms}} kg\",\"xp_sales_web_main_brandAttribute-checkedBaggage-notIncluded_a11y_label\":\"Sem bagagem despachada {{kilograms}} kg\",\"xp_sales_web_main_brandAttribute-changes-included_a11y_label\":\"Remarcação com taxa\",\"xp_sales_web_main_brandAttribute-changes-notIncluded_a11y_label\":\"Sem remarcação de passagem\",\"xp_sales_web_main_brandAttribute-flexibility-included_a11y_label\":\"Remarcação sem taxa\",\"xp_sales_web_main_brandAttribute-seatSelection-included_a11y_label\":\"Seleção de assento\",\"xp_sales_web_main_brandAttribute-seatSelection-notIncluded_a11y_label\":\"Sem seleção de assento\",\"xp_sales_web_main_brandAttribute-latamPremiumSeat-included_a11y_label\":\"Poltrona-cama\",\"xp_sales_web_main_brandAttribute-comfortableSeat-included_a11y_label\":\"Assento do meio bloqueado\",\"xp_sales_web_main_brandAttribute-refund-included_a11y_label\":\"Reembolso total\",\"xp_sales_web_main_brandAttribute-refund-notIncluded_a11y_label\":\"Sem reembolso de passagem\",\"xp_sales_web_main_brandAttribute-refund-partialIncluded_a11y_label\":\"{{totalAmount}} de reembolso\",\"xp_sales_web_main_brandAttribute-latamPlusSeat-included_a11y_label\":\"Assento LATAM+\",\"xp_sales_web_main_brandAttribute-cabinUpgradeCoupons-included_a11y_label\":\"Uso de cupom para Upgrade\",\"xp_sales_web_main_brandAttribute-cabinUpgradeCoupons-notIncluded_a11y_label\":\"Sem cupons de Upgrade\",\"xp_sales_web_main_brandPriceDetails_a11y_label\":\"Mais detalhes desta tarifa.\",\"xp_sales_web_main_brandSelectionButtonText-roundTrip_a11y_label\":\"Escolher a tarifa {{fare}} e passa para o voo seguinte\",\"xp_sales_web_main_brandSelectionButtonText-oneWay_a11y_label\":\"Escolher a tarifa {{fare}} e continuar\",\"xp_sales_web_main_closeFareList\":\"Fechar\",\"xp_sales_web_main_closeFareList_a11y_label\":\"Fechar lista de tarifas.\",\"xp_sales_web_airOffers_adultFromTxt\":\"Adulto a partir de\",\"xp_sales_web_main_includesTxt\":\"{{planeModel}} inclui\",\"xp_sales_web_main_detailsTxt\":\"Detalhes\",\"xp_sales_web_main_departureTxt\":\"Saída\",\"xp_sales_web_main_arrivalTxt\":\"Chegada\",\"xp_sales_web_main_itineraryDurationTxt\":\"Duração\",\"xp_sales_web_main_itineraryDetail\":\"Itinerário de voo\",\"xp_sales_web_main_itineraryDetailClose_a11y_label\":\"Fechar Itinerário de voo.\",\"xp_sales_web_main_itineraryDetail_a11y_label\":\"Conhecer o detalhe completo do itinerário de voo\",\"xp_sales_web_airOffers_bundleDetails_a11y_label\":\"Conhecer o detalhe completo desta tarifa.\",\"xp_sales_web_main_connectionTxt\":\"Conexão {{city}}\",\"xp_sales_web_main_scaleTxt\":\"Escala {{city}}\",\"xp_sales_web_main_airplaneChangeTxt\":\"(Troca de avião)\",\"xp_sales_web_main_noAirplaneChangeTxt\":\"(Sem troca de avião)\",\"xp_sales_web_main_operatedByTxt\":\"Operado por {{operatingAirlineName}}\",\"xp_sales_web_main_planeInfo_a11y_label\":\"Voo {{flightCode}}, {{equipmentName}}, Operado por {{operatingAirlineName}}. Inclui {{amenitiesString}}.\",\"xp_sales_web_airOffers_tripDetailsTxt\":\"Detalhes da viagem\",\"xp_sales_web_error_waitAndTryAgain\":\"Espere uns minutos e tente novamente\",\"xp_sales_web_airOffers_bundleDetail\":\"Detalhe da tarifa\",\"xp_sales_web_airOffers_bundleDetail_a11y_label\":\"Ver detalhe da tarifa\",\"xp_sales_web_airOffers_selectBundle_a11y_label\":\"Selecionar tarifa {{tarifa}} com preço de {{price}}.\",\"xp_sales_web_airOffers_saveMoneyTxt\":\"Economize {{percent}}\",\"xp_sales_web_airOffers_getMoreDetails\":\"Mais informações\",\"xp_sales_web_airOffers_getMoreDetails_a11y_label\":\"Obter mais detalhes sobre {{itemName}}.\",\"xp_sales_web_airOffers_extrasIncludedTitle\":\"Extras incluídos:\",\"xp_sales_web_airOffers_extrasIncludedSubtitle\":\"Benefícios exclusivos desta tarifa, não disponíveis separadamente\",\"xp_sales_web_airOffers_premiumEconomy\":\"Premium Economy\",\"xp_sales_web_airOffers_thisBundleIncludesTxt\":\"Esta tarifa inclui:\",\"xp_sales_web_airOffers_disclaimerTitle_list\":[\"Informação geral de voos:\",\"Voos de e para as ilhas Galápagos:\"],\"xp_sales_web_airOffers_disclaimer_list\":[\"xp_sales_web_disclaimer_generalDisclaimer_list\",\"xp_sales_web_disclaimer_galapagosDisclaimer_list\"],\"xp_sales_web_disclaimer_generalDisclaimer_list\":[\"As imagens da cabine Premium Business são para referência.\",\"Sua escolha do voo de ida determinará o preço do voo de retorno.\",\"Os lugares e valores estão sujeitos a confirmação nos passos seguintes.\",\"Para ter acesso à \\u003cstrong\\u003etarifas com desconto para a terceira idade\\u003c/strong\\u003e ou para \\u003cstrong\\u003epessoas com deficiência\\u003c/strong\\u003e, você deve realizar sua compra em nossas \\u003cstrong\\u003eLojas Físicas\\u003c/strong\\u003e ou ligando para nossa \\u003cstrong\\u003eCentral de Vendas e Serviços\\u003c/strong\\u003e no 1800-000-527.\",\"O modelo do avião pode variar por motivos operacionais.\",\"Caso escolha uma tarifa que permita uma porcentagem ou a totalidade de devolução, considere que só poderá solicitar o reembolso antes do horário de saída do primeiro voo de seu itinerário.\",\"O uso de cupons para o \\u003cstrong\\u003e\\u003ca target='_blank' href={{cabinUpgradeURL}}\\u003eupgrade de cabine\\u003c/a\\u003e\\u003c/strong\\u003e é válido apenas para a compra de tarifas Plus e Top. Revise as condições de upgrade de cabine associadas à sua tarifa.\",\"Ao escolher um voo operado por outra companhia aérea, você poderá selecionar os assentos diretamente com essa companhia.\",\"Caso sua bagagem de mão exceda o tamanho ou peso máximos permitidos, você terá a opção de despachá-la por um custo extra. Se decidir não fazê-lo, não poderemos embarcar sua bagagem no voo nem seremos responsáveis por armazená-la.\",\"Para voos saindo de e chegando aos Estados Unidos, revise as \\u003cstrong\\u003e\\u003ca href='{{optionalServicesUrl}}' target='_blank'\\u003etarifas por bagagem e serviços opcionais\\u003c/a\\u003e\\u003c/strong\\u003e.\"],\"xp_sales_web_disclaimer_galapagosDisclaimer_list\":[\"Para passageiros estrangeiros não residentes no Equador, aplica exclusivamente a tarifa Top. Qualquer outra tarifa está sujeita a uma cobrança adicional no aeroporto, de USD $150 + IVA.\",\"Por ordem do Governo Nacional do Equador, todos os passageiros não residentes em Galápagos devem apresentar sua passagem de retorno ao chegar às ilhas.\"],\"xp_sales_web_disclaimer_disclaimerTitle_a11y_label\":\"Notas legais\",\"xp_sales_web_airOffers_amenitiesTitle\":\"Comodidades: \",\"xp_sales_web_airOffers_flightSelectionTxt\":\"Seleção de voos\",\"xp_sales_web_airOffers_goToAvailableFlights\":\"Ir à lista de voos disponíveis\",\"xp_sales_web_airOffers_cardFlightSummaryExpandFares_a11y_label\":\"Ver opções de tarifa para este voo\",\"xp_sales_web_airOffers_cardFlightSummary_a11y_label\":\"Voo {{tags}}. Hora de saída {{originTime}}, partida de {{originCity}}, aeroporto {{originAirport}}, hora de chegada {{destinationTime}}, em {{destinationCity}}, aeroporto {{destinationAirport}}. Voo {{itinerary}}, com duração total de {{totalDuration}}. Preço de um adulto a partir de {{amount}}. {{flightOperator}}\",\"xp_sales_web_airOffers_cardFlightSummaryOneDaylaterArrival_a11y_label\":\"do dia seguinte\",\"xp_sales_web_airOffers_cardFlightSummaryTwoDaysLaterArrival_a11y_label\":\"dois dias depois\",\"xp_sales_web_airOffers_cardFlightSummaryThreeDaysLaterArrival_a11y_label\":\"tois dias depois\",\"xp_sales_web_airOffers_dateCarouselMain_a11y_label\":\"Buscador de voos em datas próximas.\",\"xp_sales_web_airOffers_dateCarouselLeftArrow_a11y_label\":\"Mover a {{n}} dias anteriores.\",\"xp_sales_web_airOffers_dateCarouselRightArrow_a11y_label\":\"Mover a {{n}} dias seguintes.\",\"xp_sales_web_airOffers_dateCarouselList_a11y_label\":\"Lista de datas próximas a {{day}}.\",\"xp_sales_web_airOffers_dateCarouselListItem_a11y_label\":\"{{day}}, entrar em lista de voo.\",\"xp_sales_web_airOffers_dateCarouselListItemDisabled_a11y_label\":\"{{day}}, não há voos disponíveis.\",\"xp_sales_web_airOffers_dateCarouselListItemSelected_a11y_label\":\"Resultadots de voos do dia {{day}}.\",\"xp_sales_web_airOffers_flightOperatorOneAirline\":\"Operado pela {{airline_1}}\",\"xp_sales_web_airOffers_flightOperatorOneAirline_a11y_label\":\"Operado pela {{airline_1}}.\",\"xp_sales_web_airOffers_flightOperatorTwoAirlines\":\"Operado pela {{airline_1}} e {{airline_2}}\",\"xp_sales_web_airOffers_flightOperatorTwoAirlines_a11y_label\":\"Operado pela {{airline_1}} e {{airline_2}}.\",\"xp_sales_web_airOffers_flightOperatorThreeOrMoreAirlines\":\"Operado pela {{airline_1}}, {{airline_2}} e outras\",\"xp_sales_web_airOffers_flightOperatorThreeOrMoreAirlines_a11y_label\":\"Operado pela {{airline_1}}, {{airline_2}} e outras.\",\"xp_sales_web_airOffers_availableFlights_a11y_label\":\"Voos disponíveis.\",\"xp_sales_web_airOffers_abundleDetailsSummary_a11y_label\":\"Tarifa {{name}} {{cabin}},{{additionalInfo}} preço de um adulto a partir de {{amount}}. {{servicesText}}\",\"xp_sales_web_airOffers_bundleDetailsServices_a11y_label\":\"Inclui {{services}}.\",\"xp_sales_web_airOffers_availableBundles_a11y_label\":\"Tarifas disponíveis.\",\"xp_sales_web_airOffers_OLAsRedirectionLink\":\" Ver voos com companhias aéreas associadas\",\"xp_sales_web_airOffers_OLAsRedirectionLink_a11y_label\":\" Ver voos com companhias aéreas associadas\",\"xp_sales_web_airOffers_governmentApproval\":\"(*) Voo sujeito a aprovação governamental. Isto não impede que você possa comprar suas passagens normalmente.\",\"xp_sales_web_airOffers_governmentApproval_a11y_label\":\"Voo sujeito a aprovação governamental. Isto não impede que você possa comprar suas passagens normalmente.\",\"xp_sales_web_airOffers_shortGovernmentApproval\":\"(*) Voo sujeito a aprovação governamental.\",\"xp_sales_web_airOffers_shortGovernmentApproval_a11y_label\":\"Voo sujeito a aprovação governamental.\",\"xp_sales_web_airOffers_tagRecommended\":\"Recomendado\",\"xp_sales_web_airOffers_tagCheapest\":\"Mais econômico\",\"xp_sales_web_airOffers_tagFastest\":\"Mais rápido\",\"xp_sales_web_airOffers_tagEarliest\":\"Mais cedo\",\"xp_sales_web_airOffers_selectFare\":\"Selecionar tarifa {{fare}}\",\"xp_sales_web_airOffers_noFlightsFound\":\"Não há voos para esta data\",\"xp_sales_web_airOffers_noFlightsFoundError\":\"A busca está demorando mais que o normal\",\"xp_sales_web_airOffers_tryAgainWithOtherDate\":\"Temos mais opções para você! \\u003cstrong\\u003eModifique os dias no calendário\\u003c/strong\\u003e para sua viagem.\",\"xp_sales_web_airOffers_category\":\"Categoria\",\"xp_sales_web_airOffers_personalItem\":\"Mala de mão\",\"xp_sales_web_airOffers_carryOnBaggage\":\"Bagagem de mão 10 kg\",\"xp_sales_web_airOffers_checkedBaggage\":\"Mala 23 kg\",\"xp_sales_web_airOffers_seatSelection\":\"Assento preferencial\",\"xp_sa