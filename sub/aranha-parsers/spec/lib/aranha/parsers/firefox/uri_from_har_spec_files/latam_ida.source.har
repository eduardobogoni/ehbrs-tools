Pass%0AMinha%20viagem%20seria:%20Ida%20e%20Volta%0AOrigem%20e%20Destino:%20{{origin}}{{destination}}%0AData%20de%20ida%3A%20{{outbound}}%0AData%20de%20volta%3A%20{{inbound}}%0ACabine%3A%20{{cabin}}%0AAdultos%3A%20{{adultPassengers}}%0ACrian%C3%A7as%3A%20{{childrenPassengers}}%0ABeb%C3%AAs%3A%20{{infantPassengers}}'\\u003eWhatsapp\\u003c/a\\u003e\",\"xp_sales_web_airOffers_olaReedemDescriptionOutbound\":\"Voe para mais de mil destinos internacionais com nossas companhias aéreas parceiras Delta e Qatar, trocando seus Pontos \\u003cstrong\\u003eLATAM Pass \\u003c/strong\\u003e através do \\u003ca target='_blank' href='{{olaBaseWspUrl}}Quero%20resgatar%20passagens%20com%20meus%20Pontos%20LATAM%20Pass%0AMinha%20viagem%20seria:%20Ida%20e%20Volta%0AOrigem%20e%20Destino:%20{{origin}}{{destination}}%0AData%20de%20ida%3A%20{{outbound}}%0AData%20de%20volta%3A%20{{inbound}}%0ACabine%3A%20{{cabin}}%0AAdultos%3A%20{{adultPassengers}}%0ACrian%C3%A7as%3A%20{{childrenPassengers}}%0ABeb%C3%AAs%3A%20{{infantPassengers}}'\\u003eWhatsapp\\u003c/a\\u003e\",\"xp_sales_web_airOffers_bundleDetailErrorTryAgain\":\"Não podemos entregar os detalhes da tarifa. Tente novamente.\",\"xp_sales_web_airOffers_bundleDetailErrorContinue\":\"Não podemos entregar os detalhes da tarifa. Você pode continuar com sua compra.\",\"xp_sales_web_airOffers_errorAlertButton\":\"Voltar a carregar\",\"xp_sales_web_airOffers_itineraryErrorTryAgain\":\"Não podemos entregar os detalhes de itinerário. Tente novamente.\",\"xp_sales_web_airOffers_itineraryErrorContinue\":\"Não podemos entregar os detalhes de itinerário. Você pode continuar com a sua compra.\"}}},\"webView\":\"\",\"featureFlags\":{\"installments\":true,\"pricingTransitionInHouse\":false,\"redemption\":true,\"redemptionDisclaimer\":true,\"loginRequiredOnRedemption\":true,\"redirectionOLAs\":false,\"corporate\":false,\"bffPlacesOriginsEnabled\":true,\"coexistenceBanner\":true,\"baggagePolicy\":false,\"baggageChargesAlert\":false,\"flightOperator\":false,\"st