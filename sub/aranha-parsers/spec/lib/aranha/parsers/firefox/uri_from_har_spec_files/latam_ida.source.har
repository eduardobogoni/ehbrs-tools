es_web_airOffers_seatSelectionTxt_variant1\":\"Sem seleção de assento\",\"xp_sales_web_airOffers_seatSelectionTxt_variant1_a11y_label\":\"Sem seleção de assento\",\"xp_sales_web_airOffers_seatSelectionTxt_include_variant1\":\"Seleção de assento\",\"xp_sales_web_airOffers_seatSelectionTxt_notInclude_variant1\":\"Sem seleção de assento\",\"xp_sales_web_airOffers_preferencialSeatSelectionTxt_include_variant1\":\"Seleção de assento preferencial\",\"xp_sales_web_airOffers_preferencialSeatSelectionTxt_notInclude_variant1\":\"Sem seleção de assento preferencial\",\"xp_sales_web_airOffers_bedSeatTxt_include_variant1\":\"Poltrona-cama\",\"xp_sales_web_airOffers_bedSeatTxt_notInclude_variant1\":\"Sem poltrona-cama\",\"xp_sales_web_airOffers_refundTxt_include_variant1\":\"Reembolso\",\"xp_sales_web_airOffers_refundTxt_notInclude_variant1\":\"Sem reembolso\",\"xp_sales_web_airOffers_refundTxt_partial_variant1\":\"Reembolso parcial\",\"xp_sales_web_airOffers_refundTxt_total_variant1\":\"Reembolso total\",\"xp_sales_web_airOffers_refundTxt_notInclude_variant2\":\"Sem reembolso\",\"xp_sales_web_airOffers_refundTxt_partial_variant2\":\"Até 40% de reembolso\",\"xp_sales_web_airOffers_refundTxt_total_variant2\":\"Reembolso total\",\"xp_sales_web_airOffers_bundleFoodTxt\":\"Alimentos\",\"xp_sales_web_airOffers_premiumMealTxt\":\"Gastronomia Premium\",\"xp_sales_web_airOffers_bundleFlexibilityTxt\":\"Alterações e devoluções sem multa\",\"xp_sales_web_airOffers_bundleFlexibilityTxt_total_variant1\":\"Remarcações sem custo\",\"xp_sales_web_airOffers_bundleFlexibilityTxt_include_variant1\":\"Remarcações com custo\",\"xp_sales_web_airOffers_bundleFlexibilityTxt_notInclude_variant1\":\"Sem possibilidade de remarcação\",\"xp_sales_web_airOffers_bundleChangesTxt\":\"Alterações com multa\",\"xp_sales_web_airOffers_bundleChangesTxt_include_variant1\":\"Remarcações sem multa\",\"xp_sales_web_airOffers_bundleChangesDeetsTxt_variant1\":\"Com diferença de tarifa\",\"xp_sales_web_airOffers_fareModalTitle\":\"Escolha a tarifa ideal para sua viagem\",\"xp_sales_web_airOffers_expModalTitle\":\"Quer melhorar a tarifa do seu \\u003cstrong\\u003e{{trip}}\\u003c/strong\\u003e?\",\"xp_sales_web_airOffers_expModalTripTypeOneWay\":\"Somente ida\",\"xp_sales_web_airOffers_expModalTripTypeReturnOnly\":\"Somente volta\",\"xp_sales_web_airOffers_expModalPriceButton\":\"Melhorar tarifa\",\"xp_sales_web_airOffers_fareRoundTripModalTitle\":\"Não perca a chance de \\u003cstrong\\u003emelhorar sua viagem\\u003c/strong\\u003e\",\"xp_sales_web_airOffers_fareRoundTripModalSelectButton\":\"Escolher\",\"xp_sales_web_airOffers_fareRoundTripModalSelectButtonBase\":\"Manter preço base\",\"xp_sales_web_airOffers_fareRoundTripModalSelectButton_a11y_label\":\"Escolher {{fare}}\",\"xp_sales_web_airOffers_fareRoundTripModalTripTypeTag\":\"Ida e volta\",\"xp_sales_web_airOffers_fareRoundTripModalPriceDescription\":\"Por passageiro, taxas incluídas\",\"xp_sales_web_airOffers_expModalPriceDescription\":\"Por passageiro\",\"xp_sales_web_airOffers_expModalPriceDescriptionExtra\":\"mais\",\"xp_sales_web_airOffers_fareModalBrandFare_a11y_label\":\"Tarifa {{brandFare}} {{cabinLabel}}.\",\"xp_sales_web_airOffers_fareModalBrandFareSelectButton_a11y_label\":\"Selecione a {{fare}} por\",\"xp_sales_web_fareRegul_minimumStay\":\"Estadia mínima no destino:\",\"xp_sales_web_fareRegul_maximumStay\":\"Estadia máxima no destino:\",\"xp_sales_web_fareRegul_maximumStayTime\":\"Estadia máxima no destino de {{stayance}} meses\",\"xp_sales_web_fareRegul_noFlightRestrictions\":\"Não há restrições de datas para viajar\",\"xp_sales_web_fareRegul_allowFlightChange\":\"permite alterações ao voo com penalidade de {{penaltyAmount}}, mais diferença de tarifa\",\"xp_sales_web_fareRegul_dontAllowTxt\":\"Não permite\",\"xp_sales_web_fareRegul_refundAmount\":\"o valor da devolução é {{amount}}\",\"xp_sales_web_fareRegul_dontAllowRefund\":\"Não permite devoluções\",\"xp_sales_web_fareRegul_fareFees\":\"mais diferença de tarifa\",\"xp_sales_web_fareRegul_checkConditions\":\"Revise as condições de sua passagem\",\"xp_sales_web_fareRegul_generalConditions\":\"Condições gerais de alteração de passagem\",\"xp_sales_web_fareRegul_paymentRules\":\"Escolha a forma de pagamento\",\"xp_sales_web_fareRegul_changesBeforeFlight\":\"Alterações antes da hora do voo\",\"xp_sales_web_fareRegul_changesAfterFlight\":\"Alterações depois da hora do voo\",\"xp_sales_web_fareRegul_refundsTxt\":\"Devoluções\",\"xp_sales_web_fareRegul_tripTypeTxt\":\"Sua viagem de\",\"xp_sales_web_fareRegul_departureTxt\":\"ida\",\"xp_sales_web_fareRegul_arrivalTxt\":\"volta\",\"xp_sales_web_fareRegul_otherConditions\":\"Outras condições\",\"xp_sales_web_fareRegul_stopOver\":\"Paradas intermediárias (Stopover):\",\"xp_sales_web_fareRegul_stopOverDescription\":\"Paradas intermediárias não permitidas.\",\"xp_sales_web_fareRegul_flightsTxt\":\"Voos\",\"xp_sales_web_fareRegul_refundsBeforeFlight\":\"Devoluções antes da hora do voo\",\"xp_sales_web_fareRegul_refundsAfterFlight\":\"Devoluções depois da hora do voo\",\"xp_sales_web_fareRegul_fareDifference\":\"+ diferença de tarifa\",\"xp_sales_web_fareRegul_childrenDiscount\":\"Viajar com bebê menor de 2 anos de idade\",\"xp_sales_web_fareRegul_callContactCenter\":\"\",\"xp_sales_web_fareRegul_checkChildrenDiscountConditions_list\":[\"\\u003cstrong\\u003eVoos nacionais:\\u003c/strong\\u003e você pode viajar com o bebê em seu colo e comprar a passagem do bebê sem custo adicional.\",\"\\u003cstrong\\u003eVoos internacionais:\\u003c/strong\\u003e você pode viajar com o bebê em seu colo pagando a passagem de bebê (10% da tarifa adulto mais impostos), exceto em voos saindo do México onde é sem custo.\"],\"xp_sales_web_fareRegul_specialNeedInfo\":[\"Caso você ou algum de seus acompanhantes tenham alguma necessidade especial, informe-nos no momento de fazer sua reserva e até 48 horas antes do seu voo, ligando para nosso Contact Center pelo telefone (01) 213 8200.\",\"Caso sua bagagem de mão exceda o tamanho ou peso máximos permitidos, você terá a opção de despachá-la por um custo extra. Se decidir não fazê-lo, não poderemos embarcar sua bagagem no voo nem seremos responsáveis por armazená-la.\",\"Sua tarifa Basic só permite levar um artigo pessoal, não permite bagagem de mão. Esta restrição não se aplica se você comprou Assentos LATAM+.\"],\"xp_sales_web_fareRegul_checkGeneralConditions_list\":[\"Revise as regras sobre alterações para cada uma das tarifas compradas, já que você só poderá trocar os voos cujas tarifas o permitam. Considere que, ao realizar uma alteração, será aplicada a multa mais alta ou a condição mais restritiva dos voos que deseja alterar.\",\"Se você ainda não iniciou sua viagem e quer realizar outra alteração, as tarifas de voos que oferecemos serão as disponíveis no momento da alteração e sua viagem deverá cumprir com todas as condições dessas novas tarifas.\",\"Caso tenha voado algum dos trechos da viagem e deseja fazer uma alteração, oferecemos as tarifas de voos disponíveis no momento em que realizou a compra das passagens. Neste caso, a nova viagem também deve cumprir sempre com todas as condições das tarifas.\",\"Se a tarifa original permite alterações, e no momento de fazer a alteração a mesma não está disponível ou não cumpre com o regulamento original, você terá acesso a uma nova tarifa pagando a diferença.\",\"Se você pagou parte ou a totalidade da sua tarifa em pontos, a diferença de tarifa e multa pela mudança só poderá ser paga em dinheiro.\"],\"xp_sales_web_fareRegul_checkGeneralConditionsMiles_list\":[\"Se você pagou parte ou a totalidade da sua tarifa em pontos, a diferença de tarifa e multa pela mudança só poderá ser paga em dinheiro.\"],\"xp_sales_web_fareRegul_checkRefundConditions_list\":[\"A condição mais restritiva entre os voos selecionados é a que aplica para toda a passagem (ida e volta).\",\"Ainda que sua passagem não permita devolução, você tem o direito de solicitar reembolso das taxas de embarque. Considere que em alguns países uma tarifa por serviço é cobrada na hora da compra e que este valor não é reembolsável.\"],\"xp_sales_web_fareRegul_checkRefundConditions_miles_list\":[\"Se você pagou parte ou a totalidade da sua tarifa em pontos, o reembolso será permitido apenas se você não tiver usado um segmento da sua viagem.\"],\"xp_sales_web_fareRegul_conditionsTitle\":\"Condições de sua passagem | Compras | LATAM Airlines Brasil\",\"xp_sales_web_fareRegul_flightInfo_a11y_label\":\"Voo {{flightNumber}} trecho {{path}} com data de {{date}} às {{time}}.\",\"xp_sales_web_fareRegul_flightFromToTitle\":\"{{cityOrigin}} a {{cityDeparture}}\",\"xp_sales_web_fareRegul_checkFlightConditionsTitle\":\"Revise as condições de sua passagem\",\"xp_sales_web_fareRegul_endorsementTitle\":\"Endosso\",\"xp_sales_web_fareRegul_endorsementList\":[\"Aplica-se apenas a passagens 100% pagas, em rotas 100% domésticas no Peru e iniciadas por lá.\",\"Isso pode ser feito ligando para a Contact Center, com no mínimo 24 horas antes da saída do vôo que você deseja endossar (mesmo que a viagem já tenha iniciado). Não ocorre em aeroportos ou escritórios de vendas.\",\"Deve enviar o documento de identidade do titular do bilhete, o documento de identidade do terceiro e ainda um pedido de Código do Consumidor (indicações através do nosso Contact center).\",\"Taxa de reemissão se aplica, consulte os detalhes da \\u003cstrong\\u003e\\u003ca href='{{serviceFees}}' target='_blank' rel='noopener noreferrer'\\u003ecobrança por país\\u003c/a\\u003e\\u003c/strong\\u003e.\",\"Os prêmios resgatados por meio dos Programas de Passageiro Frequente são regidos pelos procedimentos de cada programa.\",\"Aplica-se apenas a passageiros que se qualifiquem como consumidores finais, de acordo com o Código de Defesa e Defesa do Consumidor. Nesse sentido, não se aplica a empresas que tenham um contrato empresarial ou outras empresas ou passageiros que não se qualifiquem como consumidores finais.\",\"Aplica-se apenas se for a única reserva válida durante as datas que compõem o período de viagem da mesma.\",\"Caso a passagem a endossar seja de bebê ou criança e o beneficiário seja adulto, a diferença de tarifa por tipo de passageiro deverá ser paga no momento da solicitação do endosso.\"],\"xp_sales_web_fareRegul_postponementsTitle\":\"Adiamentos\",\"xp_sales_web_fareRegul_postponementsList\":[\"Aplica-se apenas para passagens 100% pagas, em rotas 100% nacionais no Peru e iniciadas nele.\",\"Os adiamentos podem ser feitos ligando para o Contact Center no mínimo 24 horas antes da partida do voo a ser adiado (mesmo que a viagem já tenha iniciado). Não é pode ser feito nos Aeroportos ou nos Escritórios de Venda.\",\"A mudança procederá sempre respeitando:\\u003cbr\\u003ea. O regulamento do bilhete original, sujeito à disponibilidade de tarifa igual ou superior; aplicando o encargo da diferença tarifária, se aplicável.\\u003cbr\\u003eb. A cobrança de reemissão se aplica, por isso consulte os detalhes da \\u003cstrong\\u003e\\u003ca href='{{serviceFees}}' target='_blank' rel='noopener noreferrer'\\u003ecobrança por país\\u003c/a\\u003e\\u003c/strong\\u003e.\\u003cbr\\u003ec. Os prêmios resgatados por meio dos Programas de Passageiro Frequente são regidos pelos procedimentos de cada programa.\",\"Caso o bilhete não tenha sido utilizado, o adiamento ficará condicionado à disponibilidade de itinerários aprovados pela Autoridade Aeronáutica (DGAC) no momento da solicitação.\",\"Caso o bilhete tenha sido utilizado parcialmente, o adiamento ficará condicionado à disponibilidade de itinerários aprovados pela Autoridade Aeronáutica (DGAC) no momento da solicitação.\",\"Aplica-se apenas aos passageiros que se qualifiquem como consumidores finais, de acordo com o Código de Defesa e Defesa do Consumidor. Nesse sentido, não se aplica a empresas que possuem contrato corporativo ou outras empresas ou passageiros que não se qualifiquem como consumidores finais.\"],\"xp_sales_web_main_textDiscount1\":\"Economize até {{brandPromotionalText}} com esta tarifa\",\"xp_sales_web_main_textDiscount2\":\", valor aumenta comprando produtos separadamente.\",\"xp_sales_web_main_basicBundleTitle\":\"Você escolheu Tarifa \\u003cspan lang='en'\\u003eBasic\\u003c/span\\u003e\",\"xp_sales_web_main_basicBundleTxt\":[\"Inclui bolsa ou mochila pequena (para levar debaixo do seu assento).\",\"Não são válidos benefícios por categoria de cliente \\u003cspan lang='en'\\u003eElite.\\u003c/span\\u003e\"],\"xp_sales_web_fareRegul_departureTripTxt\":\"Sua viagem de ida\",\"xp_sales_web_fareRegul_arrivalTripTxt\":\"Sua viagem de volta\",\"xp_sales_web_main_powerTxt\":\"Tomada elétrica*\",\"xp_sales_web_main_seatbackTxt\":\"Entretenimento a bordo (com tela na frente do assento)**\",\"xp_sales_web_main_usbTxt\":\"Carregador USB**\",\"xp_sales_web_main_mealTxt\":\"Serviço de alimentação***\",\"xp_sales_web_main_powerUsbTxt\":\"Tomada com carregador USB*\",\"xp_sales_web_main_beveragesTxt\":\"Bebidas alcoólicas e não alcoólicas***\",\"xp_sales_web_main_entertainmentTxt\":\"Entretenimento a bordo (baixando o App LATAM Play)**\",\"xp_sales_web_main_wifiTxt\":\"Wi-fi**\",\"xp_sales_web_main_powerTxt_a11y_label\":\"Tomada elétrica dependendo da cabine e tipo de avião.\",\"xp_sales_web_main_seatbackTxt_a11y_label\":\"Entretenimento a bordo com tela na frente do assento dependendo do tipo de avião.\",\"xp_sales_web_main_usbTxt_a11y_label\":\"Carregador USB dependendo do tipo de avião.\",\"xp_sales_web_main_mealTxt_a11y_label\":\"Serviço de alimentação com custo extra, dependendo do destino e sujeito às restrições do governo local.\",\"xp_sales_web_main_powerUsbTxt_a11y_label\":\"Tomada com carregador USB dependendo da cabine e tipo de avião.\",\"xp_sales_web_main_beveragesTxt_a11y_label\":\"Bebidas alcoólicas e não alcoólicas com custo extra, dependendo do destino e sujeito às restrições do governo local.\",\"xp_sales_web_main_entertainmentTxt_a11y_label\":\"Entretenimento a bordo baixando o App LATAM Play dependendo do tipo de avião.\",\"xp_sales_web_main_wifiTxt_a11y_label\":\"Wi-fi dependendo do tipo de avião.\",\"xp_sales_web_main_definitionAsterisksTxt\":\"(*) Dependendo da cabine e tipo de avião (**) Dependendo do tipo de avião (***) Com custo extra, dependendo do destino e sujeito às restrições do governo local\",\"xp_sales_web_main_detailMessage_a11y_label\":\"{{flightItineraryText}}, {{flightText}} {{fromMessage}} {{departureAirportName}} {{toMessage}} {{arrivaleAirportName}}, {{durationText}} {{durationMessage}}, {{doingText}} {{stopMessage}}\",\"xp_sales_web_sortOption_sortBy\":\"Organizar por: \",\"xp_sales_web_sortOption_recommended\":\"Recomendado\",\"xp_sales_web_sortOption_priceAscendant\":\"Mais baratos\",\"xp_sales_web_sortOption_flightDurationAscendant\":\"Mais rápidos\",\"xp_sales_web_sortOption_departureDateAscendant\":\"Saída mais cedo\",\"xp_sales_web_sortOption_departureDateDescendant\":\"Saída mais tarde\",\"xp_sales_web_sortOption_arrivalDateAscendant\":\"Chegada mais cedo\",\"xp_sales_web_sortOption_arrivalDateDescendant\":\"Chegada mais tarde\",\"xp_sales_web_airOffers_sortInfo\":\"A ordem será aplicada para seu voo de ida e volta.\",\"xp_sales_web_fareRegul_anticipateBuy\":\"Antecipação de compra:\",\"xp_sales_web_fareRegul_anticipateBuyDesc\":\"A compra deve ser realizada no mesmo momento da reserva e não pode ser paga posteriormente\",\"xp_sales_web_brandlist_premiumSeparatorTitle\":\"Cabine\",\"xp_sales_web_brandlist_premiumSeparatorSubtitle\":\"Premium Business\",\"xp_sales_web_brandlist_premiumSeparatorText\":\"Voe com o máximo conforto\",\"xp_sales_web_airOffers_extrasIncludedBussinesTitle\":\"Extras incluídos na tarifa:\",\"xp_sales_web_airOffers_thisBundleIncludesBussinesTxt\":\"Negócios Premium Exclusivos:\",\"xp_sales_web_airOffers_comfortableSeatPremiumBusinessTitle\":\"Assento de cama\",\"xp_sales_web_airOffers_comfortableSeatPremiumBusinessDescription\":\"Projeto reclinado 180º para melhor descanso.\",\"xp_sales_web_airOffers_foodPremiumBusinessTitle\":\"Gastronomia Premium\",\"xp_sales_web_airOffers_foodPremiumBusinessDescription\":\"Os melhores sabores da América Latina por chefs renomados.\",\"xp_sales_web_brandlist_premiumSeparatorDescription\":\"Nossa cabine superior de classe mundial oferece a atenção e o espaço que você merece.\",\"xp_sales_web_brand_business_subtitle\":\"Premium Business\",\"xp_sales_web_brand_economy_basic_description\":\"Apenas bolsa ou mochila pequena e sem remarcação\",\"xp_sales_web_brand_economy_light_description\":\"+Bagagem de mão de 10 kg\",\"xp_sales_web_brand_economy_light_description_variant1\":\"Ideal para viagens curtas\",\"xp_sales_web_brand_economy_plus_description\":\"+Mala 23 kg\",\"xp_sales_web_brand_economy_plus_description_variant1\":\"Inclui mais bagagem\",\"xp_sales_web_brand_economy_top_description\":\"Assento LATAM+ | Reembolso\",\"xp_sales_web_brand_economy_top_description_variant1\":\"Uma experiência única\",\"xp_sales_web_brand_premiumeconomy_plus_description\":\"Assento do meio bloqueado\",\"xp_sales_web_brand_premiumeconomy_plus_description_variant1\":\"Para uma experiência preferencial\",\"xp_sales_web_brand_premiumeconomy_top_description\":\"Assento do meio bloqueado | Reembolso\",\"xp_sales_web_brand_premiumeconomy_top_description_variant1\":\"Uma experiência única\",\"xp_sales_web_brand_premiumeconomy_top_description_variant2\":\"Para uma experiência preferencial\",\"xp_sales_web_brand_business_plus_description\":\"+Poltrona-cama 180º\",\"xp_sales_web_brand_business_plus_description_variant1\":\"Para uma experiência preferencial\",\"xp_sales_web_brand_business_top_description\":\"+Poltrona-cama 180º +Full flexível\",\"xp_sales_web_brand_business_top_description_variant1\":\"Para uma experiência preferencial\",\"xp_sales_web_airOffers_defaultErrorTitle\":\"Tivemos um problema\",\"xp_sales_web_airOffers_defaultErrorDetails\":\"Não podemos entregar as informações que você solicitou. Por favor, tente de novo.\",\"xp_sales_web_airOffe