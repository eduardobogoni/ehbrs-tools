ock;} h1{font-size:2em;margin:0.67em 0;} hr{box-sizing:content-box;height:0;overflow:visible;} pre{font-family:monospace,monospace;font-size:1em;} a{background-color:transparent;} abbr[title]{border-bottom:none;-webkit-text-decoration:underline;text-decoration:underline;-webkit-text-decoration:underline dotted;text-decoration:underline dotted;} b,strong{font-weight:bolder;} code,kbd,samp{font-family:monospace,monospace;font-size:1em;} small{font-size:80%;} sub,sup{font-size:75%;line-height:0;position:relative;vertical-align:baseline;} sub{bottom:-0.25em;} sup{top:-0.5em;} img{border-style:none;} button,input,optgroup,select,textarea{font-family:inherit;font-size:100%;line-height:1.15;margin:0;} button,input{overflow:visible;} button,select{text-transform:none;} button,[type='button'],[type='reset'],[type='submit']{-webkit-appearance:button;} button::-moz-focus-inner,[type='button']::-moz-focus-inner,[type='reset']::-moz-focus-inner,[type='submit']::-moz-focus-inner{border-style:none;padding:0;} button:-moz-focusring,[type='button']:-moz-focusring,[type='reset']:-moz-focusring,[type='submit']:-moz-focusring{outline:1px dotted ButtonText;} fieldset{padding:0.35em 0.75em 0.625em;} legend{box-sizing:border-box;color:inherit;display:table;max-width:100%;padding:0;white-space:normal;} progress{vertical-align:baseline;} textarea{overflow:auto;} [type='checkbox'],[type='radio']{box-sizing:border-box;padding:0;} [type='number']::-webkit-inner-spin-button,[type='number']::-webkit-outer-spin-button{height:auto;} [type='search']{-webkit-appearance:textfield;outline-offset:-2px;} [type='search']::-webkit-search-decoration{-webkit-appearance:none;} ::-webkit-file-upload-button{-webkit-appearance:button;font:inherit;} details{display:block;} summary{display:list-item;} template{display:none;} [hidden]{display:none;} .latam-grid{display:grid;grid-gap:1rem;grid-template-columns:repeat(4,1fr);padding:0 1rem;} @media (min-width:37.5rem){.latam-grid{grid-gap:2rem;grid-template-columns:repeat(8,1fr);padding:0 2rem;}} @media (min-width:64rem){.latam-grid{grid-gap:2.5rem;grid-template-columns:repeat(12,1fr);padding:0 3rem;}} @media (min-width:89.75rem){.latam-grid{grid-gap:3rem;grid-template-columns:repeat(12,1fr);max-width:89.75rem;margin:0 auto;padding:0 4rem;}} *{box-sizing:border-box;} html,body{font-size:16px;color:#303030;} html,body,div#__next{height:100%;} body{overscroll-behavior:none;font-family:LATAM Sans,Trebuchet MS,sans-serif;} h1{font-style:italic;font-weight:400;font-size:1.125rem;color:#1B0088;} @media (min-width:64rem){h1{font-size:2.25rem;font-weight:300;}} h1 em{font-weight:400;display:inline-block;} h2{font-style:italic;font-weight:300;font-size:1.375rem;color:#1B0088;} @media (min-width:64rem){h2{font-size:1.75rem;}} h2 em{font-weight:400;display:inline-block;} h3{font-size:1.125rem;font-weight:400;color:#1B0088;} @media (min-width:64rem){h3{font-size:1.5rem;}} h4{font-size:1rem;font-weight:600;color:#1B0088;} @media (min-width:64rem){h4{font-size:1.25rem;}} h5{font-size:0.875rem;font-weight:600;color:#1B0088;} @media (min-width:64rem){h5{font-size:1rem;}} p{font-weight:400;font-size:1rem;line-height:1.5;} p.p2{font-size:0.875rem;line-height:1.5;} p.p3{font-size:0.75rem;line-height:1.5;} p.important{font-size:1.375rem;line-height:1.5;} a{color:#4658DF;cursor:pointer;-webkit-text-decoration:none;text-decoration:none;} a.latam-typography--link{-webkit-text-decoration:underline;text-decoration:underline;} a:focus{outline:0.125rem solid #1B0088;outline-offset:0.5rem;} a:active{color:#4658DF;} a:hover{color:#2D34CE;-webkit-text-decoration:none;text-decoration:none;} a:visited{color:#6617A3;} ul li a{color:#303030;} ul li a:active{color:#303030;} ul li a:visited{color:#303030;} .latam-typography--display{font-size:2.625rem;line-height:3.25rem;-webkit-letter-spacing:0;-moz-letter-spacing:0;-ms-letter-spacing:0;letter-spacing:0;font-style:italic;font-weight:400;color:#1B0088;} @media (min-width:64rem){.latam-typography--display{font-size:4.25rem;line-height:5rem;-webkit-letter-spacing:0;-moz-letter-spacing:0;-ms-letter-spacing:0;letter-spacing:0;}} .latam-typography--heading-01{font-style:normal;font-size:2rem;line-height:2.75rem;-webkit-letter-spacing:-0.031rem;-moz-letter-spacing:-0.031rem;-ms-letter-spacing:-0.031rem;letter-spacing:-0.031rem;font-weight:300;color:#1B0088;} @media (min-width:64rem){.latam-typography--heading-01{font-size:2.9375rem;line-height:3.5rem;-webkit-letter-spacing:-0.063rem;-moz-letter-spacing:-0.063rem;-ms-letter-spacing:-0.063rem;letter-spacing:-0.063rem;}} .latam-typography--heading-02{font-style:normal;font-size:1.75rem;line-height:2rem;-webkit-letter-spacing:0;-moz-letter-spacing:0;-ms-letter-spacing:0;letter-spacing:0;font-weight:300;color:#1B0088;} @media (min-width:64rem){.latam-typography--heading-02{font-size:2.5rem;line-height:3rem;-webkit-letter-spacing:0;-moz-letter-spacing:0;-ms-letter-spacing:0;letter-spacing:0;}} .latam-typography--heading-03{font-style:normal;font-size:1.5rem;line-height:1.75rem;-webkit-letter-spacing:0.016rem;-moz-letter-spacing:0.016rem;-ms-letter-spacing:0.016rem;letter-spacing:0.016rem;font-weight:300;color:#1B0088;} @media (min-width:64rem){.latam-typography--heading-03{font-size:2.063rem;line-height:2.5rem;-webkit-letter-spacing:0.016rem;-moz-letter-spacing:0.016rem;-ms-letter-spacing:0.016rem;letter-spacing:0.016rem;}} .latam-typography--heading-04{font-style:normal;font-size:1.375rem;line-height:1.5rem;-webkit-letter-spacing:0;-moz-letter-spacing:0;-ms-letter-spacing:0;letter-spacing:0;font-weight:300;color:#1B0088;} @media (min-width:64rem){.latam-typography--heading-04{font-size:1.688rem;line-height:2rem;-webkit-letter-spacing:0;-moz-letter-spacing:0;-ms-letter-spacing:0;letter-spacing:0;}} .latam-typography--heading-05{font-style:normal;font-size:1.25rem;line-height:1.5rem;-webkit-letter-spacing:0.009rem;-moz-letter-spacing:0.009rem;-ms-letter-spacing:0.009rem;letter-spacing:0.009rem;font-weight:300;color:#1B0088;} @media (min-width:64rem){.latam-typography--heading-05{font-size:1.438rem;line-height:1.75rem;-webkit-letter-spacing:0.009rem;-moz-letter-spacing:0.009rem;-ms-letter-spacing:0.009rem;letter-spacing:0.009rem;}} .latam-typography--heading-06{font-style:normal;font-size:1.125rem;line-height:1.25rem;-webkit-letter-spacing:0.006rem;-moz-letter-spacing:0.006rem;-ms-letter-spacing:0.006rem;letter-spacing:0.006rem;font-weight:300;color:#1B0088;} @media (min-width:64rem){.latam-typography--heading-06{font-size:1.188rem;line-height:1.5rem;-webkit-letter-spacing:0.009rem;-moz-letter-spacing:0.009rem;-ms-letter-spacing:0.009rem;letter-spacing:0.009rem;}} .latam-typography--paragraph-lead{font-style:normal;font-size:1.063rem;line-height:1.5rem;-webkit-letter-spacing:0;-moz-letter-spacing:0;-ms-letter-spacing:0;letter-spacing:0;font-weight:400;color:#5C5C5C;} @media (min-width:64rem){.latam-typography--paragraph-lead{font-size:1.125rem;line-height:1.75rem;-webkit-letter-spacing:0;-moz-letter-spacing:0;-ms-letter-spacing:0;letter-spacing:0;}} .latam-typography--paragraph-base{font-style:normal;font-size:1rem;line-height:1.5rem;-webkit-letter-spacing:0.013rem;-moz-letter-spacing:0.013rem;-ms-letter-spacing:0.013rem;letter-spacing:0.013rem;font-weight:400;color:#5C5C5C;} .latam-typography--paragraph-medium{font-style:normal;font-size:0.875rem;line-height:1.25rem;-webkit-letter-spacing:0.019rem;-moz-letter-spacing:0.019rem;-ms-letter-spacing:0.019rem;letter-spacing:0.019rem;font-weight:400;color:#303030;} .latam-typography--paragraph-small{font-style:normal;font-size:0.75rem;line-height:1.125rem;-webkit-letter-spacing:0.025rem;-moz-letter-spacing:0.025rem;-ms-letter-spacing:0.025rem;letter-spacing:0.025rem;font-weight:400;color:#303030;} .latam-typography--overline{font-size:0.875rem;line-height:1.25rem;-webkit-letter-spacing:0.094rem;-moz-letter-spacing:0.094rem;-ms-letter-spacing:0.094rem;letter-spacing:0.094rem;font-weight:400;color:#303030;text-transform:uppercase;font-style:italic;}</style><script >bazadebezolkohpepadr=\"485560655\"</script><script type=\"text/javascript\" src=\"https://www.latamairlines.com/akam/13/1cf11260\"  defer></script></head><body><div id=\"__next\"></div><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"loginUrl\":\"https://www.latamairlines.com/br/pt/login\",\"dataFlight\":{\"tripTypeSelected\":{\"value\":\"RT\"},\"cabinSelected\":{\"value\":\"Economy\"},\"passengerSelected\":{\"adultQuantity\":1,\"childrenQuantity\":0,\"infantQuantity\":0},\"originSelected\":{\"iata\":\"BSB\"},\"destinationSelected\":{\"iata\":\"MCP\"},\"dateGoSelected\":\"2022-11-01T12:00:00.000Z\",\"dateReturnSelected\":\"2022-11-15T12:00:00.000Z\",\"redemption\":false},\"searchBoxServerOptions\":{\"bffEndpoint\":{\"CLIENT\":\"https://www.latamairlines.com/bff/air-offers\",\"SERVER\":\"http://bff.gateway.svc.cluster.local/bff/air-offers\"},\"appName\":\"web-air-offers\",\"lang\":\"pt\",\"country\":\"br\",\"originalCountry\":\"br\"},\"lang\":\"pt\",\"country\":\"br\",\"originalCountry\":\"br\",\"geoCountry\":\"br\"},\"home\":\"pt-br\",\"lang\":\"pt\",\"country\":\"br\",\"originalCountry\":\"br\",\"geoCountry\":\"br\",\"baseUrl\":\"https://www.latamairlines.com/br/pt\",\"features\":{\"CL\":{\"installments\":true,\"pricingTransitionInHouse\":false,\"redemption\":true,\"redemptionDisclaimer\":true,\"loginRequiredOnRedemption\":true,\"redirectionOLAs\":false,\"corporate\":true,\"bffPlacesOriginsEnabled\":true,\"coexistenceBanner\":false,\"baggagePolicy\":false,\"baggageChargesAlert\":false,\"flightOperator\":false,\"stopover\":false,\"dateCarouselEnabled\":true,\"showSclPdpBanner\":true,\"displayColumnBrands\":true,\"redemptionOLA\":false,\"redemptionNewEndpoint\":true},\"EC\":{\"installments\":false,\"pricingTransitionInHouse\":false,\"redemption\":true,\"redemptionDisclaimer\":true,\"loginRequiredOnRedemption\":true,\"redirectionOLAs\":false,\"corporate\":true,\"bffPlacesOriginsEnabled\":true,\"coexistenceBanner\":false,\"baggagePolicy\":false,\"baggageChargesAlert\":false,\"flightOperator\":false,\"stopover\":false,\"dateCarouselEnabled\":true,\"showSclPdpBanner\":false,\"displayColumnBrands\":true,\"redemptionOLA\":false,\"redemptionNewEndpoint\":true},\"CO\":{\"installments\":true,\"pricingTransitionInHouse\":false,\"redemption\":true,\"redemptionDisclaimer\":true,\"loginRequiredOnRedemption\":true,\"redirectionOLAs\":false,\"corporate\":true,\"bffPlacesOriginsEnabled\":true,\"coexistenceBanner\":false,\"baggagePolicy\":false,\"baggageChargesAlert\":false,\"flightOperator\":false,\"stopover\":false,\"dateCarouselEnabled\":true,\"showSclPdpBanner\":false,\"displayColumnBrands\":true,\"redemptionOLA\":false,\"redemptionNewEndpoint\":true},\"BR\":{\"installments\":true,\"pricingTransitionInHouse\":false,\"redemption\":true,\"redemptionDisclaimer\":true,\"loginRequiredOnRedemption\":true,\"redirectionOLAs\":false,\"corporate\":false,\"bffPlacesOriginsEnabled\":true,\"coexistenceBanner\":true,\"baggagePolicy\":false,\"baggageChargesAlert\":false,\"flightOperator\":false,\"stopover\":true,\"dateCarouselEnabled\":true,\"showSclPdpBanner\":false,\"displayColumnBrands\":true,\"redemptionOLA\":true,\"redemptionNewEndpoint\":true},\"PE\":{\"installments\":true,\"pricingTransitionInHouse\":false,\"redemption\":true,\"redemptionDisclaimer\":true,\"loginRequiredOnRedemption\":true,\"redirectionOLAs\":false,\"corporate\":false,\"bffPlacesOriginsEnabled\":true,\"coexistenceBanner\":false,\"baggagePolicy\":false,\"baggageChargesAlert\":false,\"flightOperator\":false,\"stopover\":false,\"dateCarouselEnabled\":true,\"showSclPdpBanner\":true,\"displayColumnBrands\":true,\"redemptionOLA\":false,\"redemptionNewEndpoint\":true},\"AR\":{\"installments\":true,\"pricingTransitionInHouse\":false,\"redemption\":true,\"redemptionDisclaimer\":true,\"loginRequiredOnRedemption\":true,\"redirectionOLAs\":false,\"corporate\":false,\"bffPlacesOriginsEnabled\":true,\"coexistenceBanner\":true,\"baggagePolicy\":false,\"baggageChargesAlert\":false,\"flightOperator\":false,\"stopover\":false,\"dateCarouselEnabled\":true,\"showSclPdpBanner\":true,\"displayColumnBrands\":true,\"redemptionOLA\":false,\"redemptionNewEndpoint\":true},\"US\":{\"installments\":false,\"pricingTransitionInHouse\":false,\"redemption\":true,\"redemptionDisclaimer\":true,\"loginRequiredOnRedemption\":true,\"redirectionOLAs\":false,\"corporate\":false,\"bffPlacesOriginsEnabled\":true,\"coexistenceBanner\":true,\"baggagePolicy\":true,\"baggageChargesAlert\":true,\"flightOperator\":true,\"stopover\":false,\"dateCarouselEnabled\":true,\"showSclPdpBanner\":false,\"displayColumnBrands\":true,\"redemptionOLA\":false,\"redemptionNewEndpoint\":true},\"ES\":{\"installments\":true,\"pricingTransitionInHouse\":false,\"redemption\":true,\"redemptionDisclaimer\":true,\"loginRequiredOnRedemption\":true,\"redirectionOLAs\":false,\"corporate\":false,\"bffPlacesOriginsEnabled\":true,\"coexistenceBanner\":false,\"baggagePolicy\":false,\"baggageChargesAlert\":false,\"flightOperator\":false,\"stopover\":false,\"dateCarouselEnabled\":true,\"showSclPdpBanner\":false,\"displayColumnBrands\":true,\"redemptionOLA\":false,\"redemptionNewEndpoint\":true},\"GB\":{\"installments\":true,\"pricingTransitionInHouse\":false,\"redemption\":true,\"redemptionDisclaimer\":true,\"loginRequiredOnRedemption\":true,\"redirectionOLAs\":false,\"corporate\":false,\"bffPlacesOriginsEnabled\":true,\"coexistenceBanner\":false,\"baggagePolicy\":false,\"baggageChargesAlert\":false,\"flightOperator\":false,\"stopover\":false,\"dateCarouselEnabled\":true,\"showSclPdpBanner\":false,\"displayColumnBrands\":true,\"redemptionOLA\":false,\"redemptionNewEndpoint\":true}},\"skversion\":\"2.23.0\",\"csrf\":\"73f44f61-adf1-4b30-ad28-276112607816\",\"user\":null,\"impersonated\":null,\"customerJourney\":\"O2C\",\"i18nData\":{\"pt\":{\"br\":{\"xp_sales_web_airOffers_disclaimerTitle_list\":[\"Informação geral de voos:\"],\"xp_sales_web_airOffers_disclaimer_list\":[\"xp_sales_web_disclaimer_generalDisclaimer_list\"],\"xp_sales_web_disclaimer_generalDisclaimer_list\":[\"Certifique-se de que você cumpre com os \\u003cstrong\\u003e\\u003ca href='{{govRequirementsDisclaimerUrl}}' target='_blank'\\u003erequisitos para viajar\\u003c/a\\u003e\\u003c/strong\\u003e a este destino.\",\"Caso você possua uma passagem para voo doméstico do tipo ida e volta, lembre-se de que você deverá comunicar a companhia em caso de não comparecimento no voo de ida, para que o seu voo de volta não seja cancelado, conforme regulamentação da ANAC (art. 19, da Resolução nº 400/2016) . Essa comunicação deverá ser realizada até o momento da partida do seu voo de ida.\",\"Para viagens com ida e volta: O voo de ida que você selecionar determinará os preços dos voos de retorno.\",\"Se você escolher uma tarifa que permita o reembolso de uma porcentagem ou do total do valor pago, considere que você só poderá fazer a solicitação antes do horário do primeiro voo do seu itinerário.\",\"O modelo do avião pode variar por motivos operacionais.\",\"Para alteração, será cobrada a taxa do perfil de tarifa escolhido ou 100% do valor total da tarifa (ida e volta), o que for menor (mais diferença tarifária, se houver).\",\"Os preços em reais (R$) para bagagem despachada, alterações de voos e reembolsos são indicados de acordo com a taxa pública de câmbio da data de hoje e poderão sofrer alterações, para mais ou para menos, no dia em que a transação for realizada. O valor cobrado será calculado de acordo com o câmbio da moeda estrangeira na data da transação.\",\"O uso de cupons para o Upgrade de cabine aplica-se apenas à compra de tarifas Plus e Top. Verifique as condições para \\u003cstrong\\u003e\\u003ca target='_blank' href='{{govRequirementsDisclaimerUrl}}'\\u003eupgrade de cabine\\u003c/a\\u003e\\u003c/strong\\u003e associadas com a sua tarifa\",\"Você pode pedir o reembolso integral da sua passagem desde que a solicitação seja feita até 24 horas após o recebimento do comprovante e que a sua compra tenha ocorrido ao menos 7 dias antes da data do voo, conforme art. 11 da Resolução nº 400/2016 da ANAC.\",\"Ao escolher um voo operado por outra companhia aérea, você poderá selecionar os assentos diretamente com essa companhia.\",\"Para voos com origem ou destino nos Estados Unidos, verifique as \\u003cstrong\\u003e\\u003ca target='_blank' href='{{optionalServicesUrl}}'\\u003ecobranças por bagagem e serviços opcionais.\\u003c/a\\u003e\\u003c/strong\\u003e\",\"Se o seu destino final for a Nova Zelândia ou estiver em trânsito nesse país, você deve contar com a nova \\u003cstrong\\u003e\\u003ca target='_blank' href='{{newZealandUrl}}'\\u003eautorização eletrônica de viagem (NZeTA).\\u003c/a\\u003e\\u003c/strong\\u003e\",\"Você pode solicitar reembolso antes do voo, para mais informações visite a página \\u003cstrong\\u003e\\u003ca target='_blank' href={{refundsUrl}}\\u003ecomo solicitar reembolso.\\u003c/a\\u003e\\u003c/stronge\\u003e\"],\"xp_sales_web_airOffers_disclaimer_redemption_list\":[\"xp_sales_web_disclaimer_generalDisclaimer_redemption_list\"],\"xp_sales_web_disclaimer_generalDisclaimer_redemption_list\":[\"Será cobrada uma Taxa por Aproximação de Voo por trecho e passageiro, quando a antecedência de compra for inferior a 90 dias para voos domésticos e 120 dias para voos internacionais. O valor vai depender se é um voo dentro da Brasil (17 BRL), entre países da América do Sul ou América do Sul e Caribe (9 USD), ou outro voo internacional (21 USD). O reembolso não se aplica quando solicitado voluntariamente, a menos que a Lei de Retratação e Desistência esteja sendo aplicada.\"],\"xp_sales_web_fareRegul_checkGeneralConditions_list\":[\"Revise as regras sobre alterações para cada uma das tarifas compradas, uma vez que você só poderá alterar os voos cujas tarifas o permitam. Considere que, ao realizar uma alteração, poderá ser aplicada a multa mais alta ou a condição mais restritiva relativa aos voos que deseja alterar.\",\"Caso deseje realizar alterações em seu itinerário de voos, antes ou durante sua viagem, as tarifas serão as disponíveis no momento da solicitação de alteração e sua nova passagem deverá cumprir com todas as condições desta nova tarifa. Nestes casos é possível que seja necessário o pagamento da diferença pro custo da nova tarifa.\",\"Caso você possua uma passagem para voo doméstico do tipo ida e volta, lembre-se de que você deverá comunicar a companhia em caso de não comparecimento no voo de ida, para que o seu voo de volta não seja cancelado, conforme regulamentação da ANAC (art. 19, da Resolução nº 400/2016) . Essa comunicação deverá ser realizada até o momento da partida do seu voo de ida.\",\"Se você pagou parte ou a totalidade da sua tarifa em pontos, a diferença de tarifa e multa pela mudança só poderá ser paga em dinheiro.\"],\"xp_sales_web_fareRegul_checkRefundConditions_list\":[\"A condição mais restritiva entre os voos selecionados é a que aplica para toda a compra (ida e volta).\",\"Ainda que sua passagem não permita devolução, você tem o direito de solicitar reembolso das taxas de embarque. Considere que em alguns países uma tarifa por serviço é cobrada na hora da compra e que este valor não é reembolsável.\"],\"xp_sales_web_fareRegul_extraConditions_list\":[\"Caso você ou algum de seus acompanhantes tenha alguma necessidade especial, informe-nos no momento de realizar sua reserva e até 48 horas antes de seu voo, ligando para nossa Central de Vendas e Serviços, no 0300 570 5700.\",\"Se sua bagagem de mão excede o tamanho ou peso máximo permitido, você terá a opção de despachá-la por um custo extra. Se decidir não fazê-lo, não poderemos embarcar sua bagagem no voo nem seremos responsáveis por armazená-la.\",\"Para voos fora do Brasil, a tarifa Basic só permite levar um artigo pessoal e não permite bagagem de mão. Esta restrição não se aplica se você comprou Assentos LATAM+ ou se é cliente Platinum, Black ou Black Signature.\",\"Lembre-se de que esta compra não tem direito de renúncia estabelecido pela Lei do Consumidor.\"],\"xp_sales_web_airOffers_accrualDescription\":\"Segundo sua categoria e o valor da passagem. \\u003cstrong\\u003e\\u003ca target='_blank' href='LATAM_POINTS'\\u003eMais informações.\\u003c/a\\u003e\\u003c/strong\\u003e\",\"xp_sales_web_airOffers_olaReedemTitle\":\"Resgate com tarifa fixa (assentos limitados)\",\"xp_sales_web_airOffers_olaReedemDescriptionOutboundInbound\":\"Voe para mais de mil destinos internacionais com nossas companhias aéreas parceiras Delta e Qatar, trocando seus Pontos \\u003cstrong\\u003eLATAM Pass \\u003c/strong\\u003e através do \\u003ca target='_blank' href='{{olaBaseWspUrl}}Quero%20resgatar%20passagens%20com%20meus%20Pontos%20LATAM%20Pass%0AMinha%20viagem%20seria:%20Ida%20e%20Volta%0AOrigem%20e%20Destino:%20{{origin}}{{destination}}%0AData%20de%20ida%3A%20{{outbound}}%0AData%20de%20volta%3A%20{{inbound}}%0ACabine%3A%20{{cabin}}%0AAdultos%3A%20{{adultPassengers}}%0ACrian%C3%A7as%3A%20{{childrenPassengers}}%0ABeb%C3%AAs%3A%20{{infantPassengers}}'\\u003eWhatsapp\\u003c/a\\u003e\",\"xp_sales_web_airOffers_olaReedemDescriptionOutbound\":\"Voe para mais de mil destinos internacionais com nossas companhias aéreas parceiras Delta e Qatar, trocando seus Pontos \\u003cstrong\\u003eLATAM Pass \\u003c/strong\\u003e através do \\u003ca target='_blank' href='{{olaBaseWspUrl}}Quero%20resgatar%20passagens%20com%20meus%20Pontos%20LATAM%20Pass%0AMinha%20viagem%20seria:%20Ida%20e%20Volta%0AOrigem%20e%20Destino:%20{{origin}}{{destination}}%0AData%20de%20ida%3A%20{{outbound}}%0AData%20de%20volta%3A%20{{inbound}}%0ACabine%3A%20{{cabin}}%0AAdultos%3A%20{{adultPassengers}}%0ACrian%C3%A7as%3A%20{{childrenPassengers}}%0ABeb%C3%AAs%3A%20{{infantPassengers}}'\\u003eWhatsapp\\u003c/a\\u003e\",\"xp_sales_web_airOffers_foodTitle\":\"Serviço a bordo\",\"xp_sales_web_airOffers_foodDescription\":\"Aproveite uma grande variedade de bebidas e produtos de alta qualidade.\"},\"common\":{\"xp_sales_web_url_appName\":\"oferta-voos\",\"xp_sales_web_url_pages\":[\"/error:/erro\",\"/error/default:/erro/generico\",\"/error/rate:/error/rate\",\"/error/results:/erro/tempo-resultados-busca\",\"/fareRegulations:/condicoes-passagens\",\"/tempHome:/tempHome\"],\"xp_sales_web_externalUrl_helpCenter\":\"https://www.latamairlines.com/{{originalCountry}}/pt/central-ajuda\",\"xp_sales_web_externalUrl_payment\":\"/pagamentos\",\"xp_sales_web_externalUrl_covidDisclaimerHome\":\"/experiencia/coronavirus\",\"xp_sales_web_externalUrl_covidDisclaimer\":\"/experiencia/coronavirus/maior-flexibilidade\",\"xp_sales_web_externalUrl_govRequirementsDisclaimer\":\"/experiencia/coronavirus/restricoes\",\"xp_sales_web_externalUrl_infantInPremiumCabinInfo\":\"/central-ajuda/categories?id=360004308973\\u0026section=360009273114\\u0026article=360052023273\",\"xp_sales_web_externalUrl_bundleDetailGeneralBaggage\":\"/experiencia/prepare-sua-viagem/bagagem\",\"xp_sales_web_externalUrl_awards\":\"/resgate/\",\"xp_sales_web_externalUrl_cabinUpgradeUrl\":\"/central-ajuda/perguntas/latam-pass/beneficios/upgrade-cabine\",\"xp_sales_web_externalUrl_endorsement\":\"/legal/endosso-e-postergacao\",\"xp_sales_web_externalUrl_latamOldUrl\":\"/?novaexperiencia\",\"xp_sales_web_externalUrl_optionalServices\":\"pt/legal/servicos-opcionais\",\"xp_sales_web_externalUrl_serviceFees\":\"/legal/cargos-por-servicio\",\"xp_sales_web_externalUrl_newZealand\":\"/auto-check-in/extra-documentation\",\"xp_sales_web_externalUrl_refunds\":\"/central-ajuda/perguntas/remarcacoes/reembolsos\",\"xp_sales_web_externalUrl_knowYourRights\":\"/legal/conoce-tus-derechos\",\"xp_sales_web_externalUrl_pandemicAlternatives\":\"/legal/conciliacion-latam-agrecu\",\"xp_sales_web_externalUrl_cabinBaggage\":\"/centro-ayuda/categories?id=360004261894\\u0026section=360009273034\\u0026article=360051274614\",\"xp_sales_web_externalUrl_baggageCharges\":\"/experiencia/prepare-sua-viagem/bagagem\",\"xp_sales_web_externalUrl_passengerRights\":\"/central-ajuda/perguntas/probl